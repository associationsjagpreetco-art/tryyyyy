generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Clinic {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  accent      String
  doctorName  String           @default("Clinic doctor")
  phone       String
  address     String
  language    String           @default("en")
  slotMinutes Int              @default(20)
  openingTime String           @default("09:00")
  closingTime String           @default("18:00")
  workingDays String           @default("1,2,3,4,5,6")
  modules     String           @default("appointments,followups")
  isDemo      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  patients    Patient[]
  appointments Appointment[]
  followups   FollowUp[]
  orders      OpticalOrder[]
  messages    Message[]
  templates   MessageTemplate[]
}

model Patient {
  id           String         @id @default(cuid())
  clinicId     String
  name         String
  phone        String
  reason       String?
  notes        String?
  createdAt    DateTime       @default(now())
  clinic       Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  followups    FollowUp[]
  orders       OpticalOrder[]

  @@unique([clinicId, phone])
  @@index([clinicId, name])
}

model Appointment {
  id        String   @id @default(cuid())
  clinicId  String
  patientId String
  startsAt  DateTime
  duration  Int      @default(20)
  reason    String?
  status    String   @default("BOOKED")
  source    String   @default("STAFF")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([clinicId, startsAt])
}

model FollowUp {
  id          String   @id @default(cuid())
  clinicId    String
  patientId   String
  dueAt       DateTime
  note        String
  status      String   @default("DUE")
  completedAt DateTime?
  createdAt   DateTime @default(now())
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clinicId, dueAt, status])
}

model OpticalOrder {
  id              String   @id @default(cuid())
  clinicId        String
  patientId       String
  frame           String
  lens            String
  prescriptionNote String?
  advance         Float    @default(0)
  total           Float    @default(0)
  status          String   @default("ORDERED")
  readyAt         DateTime?
  collectedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Message {
  id            String      @id @default(cuid())
  clinicId      String
  patientId     String
  appointmentId String?
  type          String
  status        String      @default("SIMULATED")
  body          String
  provider      String      @default("MockProvider")
  sentAt        DateTime    @default(now())
  reply         String?
  clinic        Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([clinicId, sentAt])
}

model MessageTemplate {
  id       String @id @default(cuid())
  clinicId String
  language String
  type     String
  body     String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, language, type])
}
